# Copy to moodle-k8s-infra/.env and fill secrets (see README).
# DO_TOKEN, MOODLE_ADMIN_*, MOODLE_WWWROOT, etc.

# Read/write split: Terraform db_node_count>=2 + standby host for Moodle readonly.
# Keep false for quiz/exam stress tests because Moodle needs read-your-writes after writes.
# Managed DO connection pool and read split are mutually exclusive in setup.sh today.
MOODLE_ENABLE_READ_SPLIT=false
MOODLE_USE_MANAGED_POOL=false

# Optional: helm retries when apiserver is flaky (see README troubleshooting)
# HELM_RETRIES=12
# HELM_RETRY_DELAY_SEC=20
