### Real auth + quiz (session cookies, POST login/processattempt → DB writes)
### Seed users + quiz matching COURSE_PATH / QUIZ_PATH.
### Allow multiple attempts per user or short runs — iteration 2+ may lack “attempt quiz” if only one attempt/user.

PROFILE=auth_quiz
QUIZ_DO_SUBMIT=true
QUIZ_TEXT_ANSWERS=2,4,8

COURSE_PATH=/course/view.php?id=2
QUIZ_PATH=/mod/quiz/view.php?id=2

# Seed accounts user0001…user0100; VU id maps 1:1 for ≤100 concurrent VUs
AUTH_USER_PREFIX=user
AUTH_USER_START=1
AUTH_USER_COUNT=100

# STAIRCASE_PLAN_PRESET drives the plan; START/STEP/MAX are display/fallback without PRESET
START_VUS=25
STEP_VUS=25
MAX_VUS=100

# Short smoke: +25 VU per stage to 100 VU, ≤300s wall time (4×75s)
STAIRCASE_PLAN_PRESET=75s:25,75s:50,75s:75,75s:100

# Abort thresholds (raise MAX_FAIL_RATE to always finish all stages)
MAX_P95_MS=120000
MAX_FAIL_RATE=0.25
ABORT_DELAY=30s

MAX_REDIRECTS=10
HTTP_TIMEOUT=120s

# Think time (login, course, quiz, before submit, between iterations)
THINK_AFTER_HOME_MIN_SEC=0
THINK_AFTER_HOME_MAX_SEC=0.3
THINK_AFTER_LOGIN_MIN_SEC=1
THINK_AFTER_LOGIN_MAX_SEC=3
THINK_AFTER_COURSE_MIN_SEC=0.5
THINK_AFTER_COURSE_MAX_SEC=2
THINK_AFTER_QUIZ_VIEW_MIN_SEC=1
THINK_AFTER_QUIZ_VIEW_MAX_SEC=3
THINK_BEFORE_SUBMIT_MIN_SEC=2
THINK_BEFORE_SUBMIT_MAX_SEC=8
THINK_AFTER_SUMMARY_MIN_SEC=0.5
THINK_AFTER_SUMMARY_MAX_SEC=2
THINK_ITERATION_MIN_SEC=3
THINK_ITERATION_MAX_SEC=10

# Terminal: k6 log only in results/ unless LIVE_K6_OUTPUT=true ./run-stress-test.sh
# SHOW_WEB_DASHBOARD=false — do not open browser (default in run-stress-test.sh is true)
