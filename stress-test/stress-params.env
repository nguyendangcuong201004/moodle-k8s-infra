### Real auth + quiz (session cookies, POST login/processattempt → DB writes)
### Seed users + quiz matching COURSE_PATH / QUIZ_PATH.
### Allow multiple attempts per user or short runs — iteration 2+ may lack “attempt quiz” if only one attempt/user.
### PROFILE=auth_quiz          → students only (home→login→course→quiz→attempt→summary)
### PROFILE=mixed_roles         → students + teachers (TEACHER_RATIO_PCT % of VUs are teachers)
###   Teacher journey: home → login → course → quiz view → quiz report → gradebook

PROFILE=mixed_roles
QUIZ_DO_SUBMIT=true
QUIZ_TEXT_ANSWERS=2,4,8

COURSE_PATH=/course/view.php?id=2
QUIZ_PATH=/mod/quiz/view.php?id=2

# Seed accounts user0001…user0500; VU maps round-robin with ≤500 concurrent VUs
AUTH_USER_PREFIX=user
AUTH_USER_START=1
AUTH_USER_COUNT=500

# Teacher accounts (seed with seed-auth-quiz-data.sh); 20% of VUs behave as teachers
TEACHER_USER_PREFIX=teacher
TEACHER_USER_START=1
TEACHER_USER_COUNT=100
TEACHER_USER_PASSWORD=123456
TEACHER_RATIO_PCT=20

# STAIRCASE_PLAN_PRESET drives the plan; START/STEP/MAX are display/fallback without PRESET
START_VUS=100
STEP_VUS=100
MAX_VUS=500

# 5×75s wall time (~375s): staircase to 500 VU (100 → 200 → 300 → 400 → 500)
STAIRCASE_PLAN_PRESET=75s:100,75s:200,75s:300,75s:400,75s:500

# Breakpoint: abort if SLO breached (k6 checks each metric; delay bundles evaluation)
MAX_P95_MS=3000
MAX_P99_MS=5000
MAX_FAIL_RATE=0.005
ABORT_DELAY=30s

MAX_REDIRECTS=10
HTTP_TIMEOUT=120s

# Think time (login, course, quiz, before submit, between iterations)
THINK_AFTER_HOME_MIN_SEC=0
THINK_AFTER_HOME_MAX_SEC=0.3
THINK_AFTER_LOGIN_MIN_SEC=1
THINK_AFTER_LOGIN_MAX_SEC=3
THINK_AFTER_COURSE_MIN_SEC=0.5
THINK_AFTER_COURSE_MAX_SEC=2
THINK_AFTER_QUIZ_VIEW_MIN_SEC=1
THINK_AFTER_QUIZ_VIEW_MAX_SEC=3
THINK_BEFORE_SUBMIT_MIN_SEC=2
THINK_BEFORE_SUBMIT_MAX_SEC=8
THINK_AFTER_SUMMARY_MIN_SEC=0.5
THINK_AFTER_SUMMARY_MAX_SEC=2
THINK_ITERATION_MIN_SEC=3
THINK_ITERATION_MAX_SEC=10

# Teacher-specific think time (quiz report, gradebook)
THINK_AFTER_REPORT_MIN_SEC=0.5
THINK_AFTER_REPORT_MAX_SEC=2
THINK_AFTER_GRADEBOOK_MIN_SEC=0.5
THINK_AFTER_GRADEBOOK_MAX_SEC=2

# Terminal: k6 log only in results/ unless LIVE_K6_OUTPUT=true ./run-stress-test.sh
# SHOW_WEB_DASHBOARD=false — do not open browser (default in run-stress-test.sh is true)
