### Staircase capacity test parameters for run-stress-test.sh
### Single run, VUs increase step-by-step, abort immediately on SLA breach.

# Starting concurrent VUs for capacity sweep
START_VUS=50

# Step size when increasing VUs
STEP_VUS=50

# Maximum VUs to test up to
MAX_VUS=300

# Stage timing per VU step
STEP_RAMP=10s
STEP_HOLD=60s

# SLA thresholds
MAX_P95_MS=2500
MAX_FAIL_RATE=0.02

# Abort delay once threshold is breached (gives short buffer to observe sustained breach)
ABORT_DELAY=30s

# HTTP request controls to expose redirect-loop and timeout bottlenecks
MAX_REDIRECTS=5
HTTP_TIMEOUT=12s

