### Capacity test parameters for run-stress-test.sh
### Edit this file to change the test without touching scripts.

# Starting concurrent VUs for capacity sweep
START_VUS=20

# Step size when increasing VUs
STEP_VUS=20

# Maximum VUs to test up to
MAX_VUS=400

# Duration for each k6 run (per VU level)
TEST_DURATION=2m

# SLA thresholds
MAX_P95_MS=2000
MAX_FAIL_RATE=0.02

# Cooldown between runs
COOLDOWN_SEC=0

