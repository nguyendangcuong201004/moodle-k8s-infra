{
  "title": "Moodle — Operations, SLO & scale",
  "description": "Merged: synthetic k6 probes (incl. checks/VUs), Moodle & Redis pod resources, CronJob & network, deployment/HPA, Moodle CPU vs limits — single dashboard (replaces Overview + Thesis Performance).",
  "tags": [
    "moodle",
    "kubernetes",
    "slo",
    "hpa"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Synthetic probes (k6)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Synthetic Probe — Requests / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{testid=\"moodle-synthetic\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Synthetic Probe — Latency (avg / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "k6_http_req_duration_avg{testid=\"moodle-synthetic\"}",
          "legendFormat": "avg",
          "refId": "A"
        },
        {
          "expr": "k6_http_req_duration_p95{testid=\"moodle-synthetic\"}",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "k6_http_req_duration_p99{testid=\"moodle-synthetic\"}",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2
        }
      }
    },
    {
      "id": 4,
      "title": "Synthetic Probe — Failure Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "k6_http_req_failed_rate{testid=\"moodle-synthetic\"}",
          "legendFormat": "failed rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4
        }
      }
    },
    {
      "id": 5,
      "title": "Synthetic Probe - Checks Pass Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "k6_checks_rate{testid=\"moodle-synthetic\"}",
          "legendFormat": "checks pass rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4
        }
      }
    },
    {
      "id": 6,
      "title": "Synthetic Probe - Iterations / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "expr": "rate(k6_iterations_total{testid=\"moodle-synthetic\"}[5m])",
          "legendFormat": "iters/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        }
      }
    },
    {
      "id": 7,
      "title": "Synthetic Probe - Active VUs",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "expr": "k6_vus{testid=\"moodle-synthetic\"}",
          "legendFormat": "vus",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Moodle pods & autoscale",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 9,
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"moodle\",container=\"moodle\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Pod Memory Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"moodle\",container=\"moodle\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Replicas — Deployment (spec vs ready) & HPA when present",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ deployment }} — spec (desired)",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"moodle\"}",
          "legendFormat": "{{ deployment }} — ready",
          "refId": "B"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ horizontalpodautoscaler }} — HPA current",
          "refId": "C"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ horizontalpodautoscaler }} — HPA min",
          "refId": "D"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ horizontalpodautoscaler }} — HPA max",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Pod Restarts",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"moodle\"})",
          "legendFormat": "Total Restarts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "CronJob, network & Redis pods",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 14,
      "title": "CronJob — Succeeded / Failed",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "kube_job_status_succeeded{namespace=\"moodle\"}",
          "legendFormat": "Succeeded",
          "refId": "A"
        },
        {
          "expr": "kube_job_status_failed{namespace=\"moodle\"}",
          "legendFormat": "Failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 15,
      "title": "Network I/O (Receive)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"moodle\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }} — receive",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"moodle\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }} — transmit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 16,
      "title": "Redis Pod CPU Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"moodle\",container=\"redis\",pod=~\".*redis.*\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 17,
      "title": "Redis Pod Memory Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"moodle\",container=\"redis\",pod=~\".*redis.*\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "CPU vs limits & throttling",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      }
    },
    {
      "id": 19,
      "title": "Moodle pod CPU vs limit",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"moodle\",container=\"moodle\"}[2m])) by (pod) / on(pod) group_left() sum(kube_pod_container_resource_limits{namespace=\"moodle\",container=\"moodle\",resource=\"cpu\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "id": 20,
      "title": "Moodle pod CPU throttling",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"moodle\",container=\"moodle\"}[5m])) by (pod) / clamp_min(sum(rate(container_cpu_cfs_periods_total{namespace=\"moodle\",container=\"moodle\"}[5m])) by (pod), 1)",
          "legendFormat": "{{ pod }} — throttled ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        }
      }
    }
  ],
  "annotations": {},
  "editable": true,
  "gnetId": null,
  "uid": null,
  "links": [],
  "schemaVersion": 39,
  "version": 1
}
