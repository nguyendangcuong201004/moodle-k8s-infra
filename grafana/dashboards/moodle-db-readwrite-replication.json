{
  "annotations": {},
  "editable": true,
  "gnetId": null,
  "links": [],
  "schemaVersion": 39,
  "timezone": "browser",
  "title": "Moodle \u2014 Database read/write & replication",
  "description": "Primary/replica effectiveness: exporter availability, PgBouncer write vs read pools, PostgreSQL tuple/block read/write activity, transaction mix, locks, conflicts, and replication lag. Read/replica panels render 0 when the read path is absent.",
  "uid": "moodle-db-readwrite-replication",
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "moodle",
    "postgres",
    "read-replica",
    "pgbouncer"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Exporter availability",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Primary DB exporter up",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(up{component=\"postgres\"}) or on() vector(0)",
          "legendFormat": "postgres",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Standby DB exporter up",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(up{component=\"postgres-standby\"}) or on() vector(0)",
          "legendFormat": "postgres-standby",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
