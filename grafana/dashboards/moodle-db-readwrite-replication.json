      "title": "Write PgBouncer exporter up",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(up{component=\"pgbouncer\"}) or on() vector(0)",
          "legendFormat": "pgbouncer",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
