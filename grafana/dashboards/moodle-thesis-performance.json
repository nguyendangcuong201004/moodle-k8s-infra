{
  "title": "Moodle (Thesis) — Performance & Autoscale",
  "description": "Condensed thesis dashboard: synthetic SLO probes, Moodle pod resources, deployment replicas (always) + optional HPA series when autoscaling.enabled, and CPU saturation versus limits.",
  "tags": ["moodle", "thesis", "hpa"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Synthetic Probe — Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{testid=\"moodle-synthetic\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line" } } }
    },
    {
      "id": 2,
      "title": "Synthetic Probe — Latency (avg / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "k6_http_req_duration_avg{testid=\"moodle-synthetic\"}",
          "legendFormat": "avg",
          "refId": "A"
        },
        {
          "expr": "k6_http_req_duration_p95{testid=\"moodle-synthetic\"}",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "k6_http_req_duration_p99{testid=\"moodle-synthetic\"}",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 2 } }
    },
    {
      "id": 3,
      "title": "Synthetic Probe — Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "k6_http_req_failed_rate{testid=\"moodle-synthetic\"}",
          "legendFormat": "failed rate",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 4 } }
    },
    {
      "id": 4,
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"moodle\",container=\"moodle\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Pod Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"moodle\",container=\"moodle\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Replicas — Deployment (spec vs ready) & HPA when present",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ deployment }} — spec (desired)",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"moodle\"}",
          "legendFormat": "{{ deployment }} — ready",
          "refId": "B"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ horizontalpodautoscaler }} — HPA current",
          "refId": "C"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ horizontalpodautoscaler }} — HPA min",
          "refId": "D"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"moodle\"}",
          "legendFormat": "{{ horizontalpodautoscaler }} — HPA max",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Pod Restarts",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"moodle\"})",
          "legendFormat": "Total Restarts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Moodle pod CPU vs limit",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"moodle\",container=\"moodle\"}[2m])) by (pod) / on(pod) group_left() sum(kube_pod_container_resource_limits{namespace=\"moodle\",container=\"moodle\",resource=\"cpu\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }
        }
      }
    },
    {
      "id": 9,
      "title": "Moodle pod CPU throttling",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"moodle\",container=\"moodle\"}[5m])) by (pod) / clamp_min(sum(rate(container_cpu_cfs_periods_total{namespace=\"moodle\",container=\"moodle\"}[5m])) by (pod), 1)",
          "legendFormat": "{{ pod }} — throttled ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      }
    }
  ],
  "annotations": {},
  "editable": true,
  "gnetId": null,
  "uid": null,
  "links": [],
  "schemaVersion": 39,
  "version": 1
}
