{
  "title": "Moodle — Runtime stack saturation",
  "description": "Application runtime bottlenecks: PHP-FPM worker pressure, PgBouncer pool saturation, and Redis cache/session behavior. Database primary/replica and node capacity live in separate dashboards.",
  "tags": [
    "moodle",
    "php-fpm",
    "pgbouncer",
    "redis"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "PHP-FPM (web tier)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "FPM listen queue (>0 = bottleneck)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(phpfpm_listen_queue) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      }
    },
    {
      "id": 3,
      "title": "FPM active vs idle workers",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(phpfpm_active_processes) by (pod)",
          "legendFormat": "{{ pod }} — active",
          "refId": "A"
        },
        {
          "expr": "sum(phpfpm_idle_processes) by (pod)",
          "legendFormat": "{{ pod }} — idle",
          "refId": "B"
        },
        {
          "expr": "sum(phpfpm_max_children) by (pod)",
          "legendFormat": "{{ pod }} — max",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 4,
      "title": "FPM max_children_reached / slow_requests",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(phpfpm_max_children_reached[5m])) by (pod)",
          "legendFormat": "{{ pod }} — max_reached/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(phpfpm_slow_requests[5m])) by (pod)",
          "legendFormat": "{{ pod }} — slow_req/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "PgBouncer (DB pool)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 6,
      "title": "Clients waiting (>0 = pool exhausted)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(pgbouncer_pools_client_waiting_connections) by (pod, database)",
          "legendFormat": "{{ pod }} / {{ database }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Server connections by state",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(pgbouncer_pools_server_active_connections) by (pod)",
          "legendFormat": "{{ pod }} — sv_active",
          "refId": "A"
        },
        {
          "expr": "sum(pgbouncer_pools_server_idle_connections) by (pod)",
          "legendFormat": "{{ pod }} — sv_idle",
          "refId": "B"
        },
        {
          "expr": "sum(pgbouncer_pools_server_used_connections) by (pod)",
          "legendFormat": "{{ pod }} — sv_used",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 8,
      "title": "Max wait time (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "expr": "max(pgbouncer_pools_client_maxwait_seconds) by (pod, database)",
          "legendFormat": "{{ pod }} / {{ database }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Redis (session & cache)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 10,
      "title": "Redis PHP session hit ratio",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 3,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "((sum(rate(redis_keyspace_hits_total{component=\"redis-session\"}[5m])) / (sum(rate(redis_keyspace_hits_total{component=\"redis-session\"}[5m])) + sum(rate(redis_keyspace_misses_total{component=\"redis-session\"}[5m])))) unless ((sum(rate(redis_keyspace_hits_total{component=\"redis-session\"}[5m])) + sum(rate(redis_keyspace_misses_total{component=\"redis-session\"}[5m]))) == 0)) or on() vector(0)",
          "legendFormat": "redis-session",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Redis L2 app cache hit ratio",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 3,
        "x": 3,
        "y": 17
      },
      "targets": [
        {
          "expr": "((sum(rate(redis_keyspace_hits_total{component=\"redis-cache\"}[5m])) / (sum(rate(redis_keyspace_hits_total{component=\"redis-cache\"}[5m])) + sum(rate(redis_keyspace_misses_total{component=\"redis-cache\"}[5m])))) unless ((sum(rate(redis_keyspace_hits_total{component=\"redis-cache\"}[5m])) + sum(rate(redis_keyspace_misses_total{component=\"redis-cache\"}[5m]))) == 0)) or on() vector(0)",
          "legendFormat": "redis-cache",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Evictions / sec by role (>0 = memory pressure)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 17
      },
      "targets": [
        {
          "expr": "sum(rate(redis_evicted_keys_total[5m])) by (component)",
          "legendFormat": "{{ component }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Memory used vs maxmemory by role",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "expr": "sum(redis_memory_used_bytes) by (component)",
          "legendFormat": "{{ component }} used",
          "refId": "A"
        },
        {
          "expr": "sum(redis_memory_max_bytes) by (component)",
          "legendFormat": "{{ component }} max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 14,
      "title": "Connected / blocked clients by role",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 17
      },
      "targets": [
        {
          "expr": "sum(redis_connected_clients) by (component)",
          "legendFormat": "{{ component }} connected",
          "refId": "A"
        },
        {
          "expr": "sum(redis_blocked_clients) by (component)",
          "legendFormat": "{{ component }} blocked",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 15,
      "title": "Commands rate by type and role",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "topk(16, sum(rate(redis_commands_total[5m])) by (component, cmd))",
          "legendFormat": "{{ component }} / {{ cmd }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ],
  "annotations": {},
  "editable": true,
  "gnetId": null,
  "uid": "moodle-runtime-stack-saturation",
  "links": [],
  "schemaVersion": 39,
  "version": 1
}
