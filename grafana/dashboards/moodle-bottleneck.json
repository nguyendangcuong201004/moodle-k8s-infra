{
  "title": "Moodle Bottleneck Analysis",
  "description": "Saturation metrics across PHP-FPM, PgBouncer, Redis, PostgreSQL — to pinpoint bottlenecks during stress test.",
  "tags": ["moodle", "bottleneck", "saturation"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "PHP-FPM (web tier)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 101,
      "title": "FPM listen queue (>0 = bottleneck)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(phpfpm_listen_queue) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25, "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 102,
      "title": "FPM active vs idle workers",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum(phpfpm_active_processes) by (pod)",
          "legendFormat": "{{ pod }} — active",
          "refId": "A"
        },
        {
          "expr": "sum(phpfpm_idle_processes) by (pod)",
          "legendFormat": "{{ pod }} — idle",
          "refId": "B"
        },
        {
          "expr": "sum(phpfpm_max_children) by (pod)",
          "legendFormat": "{{ pod }} — max",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 103,
      "title": "FPM max_children_reached / slow_requests",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(phpfpm_max_children_reached[5m])) by (pod)",
          "legendFormat": "{{ pod }} — max_reached/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(phpfpm_slow_requests[5m])) by (pod)",
          "legendFormat": "{{ pod }} — slow_req/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2 }
        }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "PgBouncer (DB pool)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }
    },
    {
      "id": 201,
      "title": "Clients waiting (>0 = pool exhausted)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum(pgbouncer_pools_client_waiting_connections) by (pod, database)",
          "legendFormat": "{{ pod }} / {{ database }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25 }
        }
      }
    },
    {
      "id": 202,
      "title": "Server connections by state",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "targets": [
        {
          "expr": "sum(pgbouncer_pools_server_active_connections) by (pod)",
          "legendFormat": "{{ pod }} — sv_active",
          "refId": "A"
        },
        {
          "expr": "sum(pgbouncer_pools_server_idle_connections) by (pod)",
          "legendFormat": "{{ pod }} — sv_idle",
          "refId": "B"
        },
        {
          "expr": "sum(pgbouncer_pools_server_used_connections) by (pod)",
          "legendFormat": "{{ pod }} — sv_used",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 203,
      "title": "Max wait time (s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "targets": [
        {
          "expr": "max(pgbouncer_pools_client_maxwait_seconds) by (pod, database)",
          "legendFormat": "{{ pod }} / {{ database }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Redis (cache & session)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "id": 301,
      "title": "Redis cache hit ratio (MUC app)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 3, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(redis_keyspace_hits_total{component=\"redis-cache\"}[5m])) / (sum(rate(redis_keyspace_hits_total{component=\"redis-cache\"}[5m])) + sum(rate(redis_keyspace_misses_total{component=\"redis-cache\"}[5m])))",
          "legendFormat": "redis-cache",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "id": 306,
      "title": "Redis session hit ratio",
      "type": "stat",
      "gridPos": { "h": 7, "w": 3, "x": 3, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(redis_keyspace_hits_total{component=\"redis-session\"}[5m])) / (sum(rate(redis_keyspace_hits_total{component=\"redis-session\"}[5m])) + sum(rate(redis_keyspace_misses_total{component=\"redis-session\"}[5m])))",
          "legendFormat": "redis-session",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "id": 302,
      "title": "Evictions / sec by role (>0 = memory pressure)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(redis_evicted_keys_total[5m])) by (component)",
          "legendFormat": "{{ component }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 30 }
        }
      }
    },
    {
      "id": 303,
      "title": "Memory used vs maxmemory by role",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "sum(redis_memory_used_bytes) by (component)",
          "legendFormat": "{{ component }} used",
          "refId": "A"
        },
        {
          "expr": "sum(redis_memory_max_bytes) by (component)",
          "legendFormat": "{{ component }} max",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 304,
      "title": "Connected / blocked clients by role",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 17 },
      "targets": [
        {
          "expr": "sum(redis_connected_clients) by (component)",
          "legendFormat": "{{ component }} connected",
          "refId": "A"
        },
        {
          "expr": "sum(redis_blocked_clients) by (component)",
          "legendFormat": "{{ component }} blocked",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 305,
      "title": "Commands rate by type and role",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "topk(16, sum(rate(redis_commands_total[5m])) by (component, cmd))",
          "legendFormat": "{{ component }} / {{ cmd }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 400,
      "type": "row",
      "title": "PostgreSQL (Managed DB)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "id": 401,
      "title": "Active connections by state",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count) by (state)",
          "legendFormat": "{{ state }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 402,
      "title": "Cache hit ratio (heap blocks)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"moodle\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"moodle\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"moodle\"}[5m])))",
          "legendFormat": "buffer hit",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "id": 403,
      "title": "Transactions per second",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"moodle\"}[1m]))",
          "legendFormat": "commits/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"moodle\"}[1m]))",
          "legendFormat": "rollbacks/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 404,
      "title": "Locks by mode (moodle DB)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 39 },
      "targets": [
        {
          "expr": "sum(pg_locks_count{datname=\"moodle\"}) by (mode)",
          "legendFormat": "{{ mode }}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 405,
      "title": "Deadlocks / Conflicts",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 39 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks{datname=\"moodle\"}[5m]))",
          "legendFormat": "deadlocks/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_conflicts{datname=\"moodle\"}[5m]))",
          "legendFormat": "conflicts/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 406,
      "title": "Top slow queries (mean exec time, ms)",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 46 },
      "targets": [
        {
          "expr": "topk(10, pg_stat_statements_mean_exec_seconds_total) * 1000",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1
        }
      }
    },
    {
      "id": 500,
      "type": "row",
      "title": "Saturation summary",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 55 }
    },
    {
      "id": 501,
      "title": "Moodle pod CPU vs limit",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"moodle\",container=\"moodle\"}[2m])) by (pod) / on(pod) group_left() sum(kube_pod_container_resource_limits{namespace=\"moodle\",container=\"moodle\",resource=\"cpu\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }
        }
      }
    },
    {
      "id": 502,
      "title": "Moodle pod CPU throttling",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_cfs_throttled_seconds_total{namespace=\"moodle\",container=\"moodle\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }} — throttled s/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 25 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
